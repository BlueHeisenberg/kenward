# kenward — systemd unit for the Linux binary install (not the container
# path; see ../Dockerfile and compose.*.yml for that). Install to
# /etc/systemd/system/kenward.service, then:
#
#   sudo mkdir -p /etc/kenward
#   sudo $EDITOR /etc/kenward/kenward.yaml            # mode: simple | isolated
#   sudo mkdir -p -m 0700 /etc/kenward/credentials
#   sudo install -m 0600 /dev/stdin /etc/kenward/credentials/bot_token <<< '<token>'
#   # ... one file per secret this household actually uses — see the
#   # LoadCredential= block below for the exact names.
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kenward
#
# This unit holds key material (session keys unwrapped in memory, Telegram
# bot tokens, provider API keys) for a service that also needs to reach the
# public internet (Telegram, cloud providers) and spawn a subprocess (`lore
# mcp`). Every hardening line below is there because of one of those three
# facts. Comments explain each so an operator can loosen a specific one
# knowingly rather than disabling hardening wholesale.

[Unit]
Description=kenward household assistant
Documentation=https://github.com/BlueHeisenberg/kenward
# Telegram and any cloud provider tier need a working network before the
# first turn; wait for it rather than starting into a guaranteed failure.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kenward run --config /etc/kenward/kenward.yaml --data-dir /var/lib/kenward

# --- Secrets: LoadCredential=, not EnvironmentFile= ---
# An EnvironmentFile= value lives in this process's environment for as long
# as it runs: readable via /proc/<pid>/environ by anything with access to
# that (this unit's user, or root), and automatically inherited by every
# child process it spawns — including the `lore mcp` subprocess kenward
# starts, whether or not lore has any business seeing a Telegram token.
# LoadCredential= avoids both: each credential is materialised as its own
# read-only (mode 0400) file under $CREDENTIALS_DIRECTORY, a directory
# systemd creates for this unit alone, backed by non-swappable memory, and
# torn down the moment the unit stops. There is nothing to grep out of
# /proc, and a child process gets nothing unless it deliberately opens that
# exact file — the environment variable it does inherit, $CREDENTIALS_DIRECTORY,
# is just a path, not a secret.
#
# internal/config looks for these names under $CREDENTIALS_DIRECTORY with no
# further configuration (see docs/IMPLEMENTATION.md §4 once updated to
# describe the new secret sources):
#   bot_token               - the household bot (simple mode / group unit)
#   bot_token.<member id>   - a member's own bot
#   api_key.<endpoint name> - a provider key, one per endpoint that needs one
#
# The PATH half of each line below is read by systemd itself — running as
# root, before it drops privileges to this unit's (dynamic) user — so the
# source files in /etc/kenward/credentials/ can stay root:root mode 0600 and
# never need to be chowned to whatever uid DynamicUser happens to pick this
# time around; that re-ownership only has to happen (and does, automatically)
# on the copy systemd hands to the unit, not on the source file. One example
# of each naming form below; add or remove lines to match this household's
# actual members and endpoints (kenward.yaml).
LoadCredential=bot_token:/etc/kenward/credentials/bot_token
LoadCredential=bot_token.david:/etc/kenward/credentials/bot_token.david
LoadCredential=api_key.openrouter:/etc/kenward/credentials/api_key.openrouter
# The session passphrase, without which no member's key can be unwrapped and
# every private message is answered with the locked notice. Which line you want
# depends on the mode, and they are not interchangeable.
#
# Leave `session: passphrase_env` / `passphrase_file` OUT of kenward.yaml when
# you use the credential below. Those fields exist for the compose path, where
# there is no credentials directory and naming the source is what turns a
# missing passphrase into a message; here the credential IS the source, and a
# kenward.yaml naming a variable this unit deliberately never sets would be
# refused at load for the variable's absence.
#   simple   — one node passphrase wraps every member's key:
LoadCredential=kenward-passphrase:/etc/kenward/credentials/kenward-passphrase
#   isolated — one per member, wrapping that member's key and nobody else's.
#              This unit is then the host supervisor, which provisions each
#              pod's own into that pod. Add one line per member and drop the
#              node passphrase above:
# LoadCredential=passphrase.david:/etc/kenward/credentials/passphrase.david

Restart=on-failure
RestartSec=5s

# --- Identity ---
# DynamicUser allocates a throwaway, unprivileged uid/gid for this unit only
# at start, never reused elsewhere, with no shell and no home directory —
# there is no static "kenward" account for an attacker to already know the
# name of. Loosen to a dedicated static user (comment this out and set
# `User=kenward`/`Group=kenward` instead, after `useradd --system kenward`)
# only if something outside systemd's management needs a stable uid, e.g.
# matching ownership of a `lore` binary or LORE_HOME laid down by another
# tool.
DynamicUser=yes

# Persistent, writable state (session key material while unlocked stays in
# memory only and is never written here; this is for enrolment claim-code
# storage and, if memory.lore_command points LORE_HOME under it, lore's own
# on-disk store). Resolves to /var/lib/kenward. DynamicUser's allocated uid
# is not guaranteed to be the same from one start to the next, but systemd
# re-chowns StateDirectory's contents to whichever uid this start got before
# ExecStart runs, so nothing here needs a fixed uid to keep working.
#
# This is a different directory from $CREDENTIALS_DIRECTORY above, and the
# two must not be confused: credentials are a transient, systemd-managed
# tmpfs torn down at every stop and rebuilt from the LoadCredential= sources
# at every start, while StateDirectory is where kenward itself persists
# things across restarts. Nothing kenward needs to keep belongs in the
# credentials directory, and no secret belongs in StateDirectory.
StateDirectory=kenward
StateDirectoryMode=0700

# --- Filesystem ---
# Makes the entire filesystem read-only except /dev, /proc, /sys and the
# paths explicitly granted (StateDirectory above). /etc/kenward stays
# readable — ProtectSystem does not block reads, only writes outside the
# granted paths.
ProtectSystem=strict
# This service has no legitimate reason to read a user's home directory;
# hides them entirely rather than merely denying writes.
ProtectHome=yes
# Private, unshared /tmp — the scratch space kenward or a spawned `lore`
# process might use disappears with the unit rather than lingering or being
# visible to other services.
PrivateTmp=yes

# --- Privilege ---
# No process this unit starts (including the spawned `lore mcp` subprocess)
# may gain privileges it didn't start with, e.g. via a setuid binary.
NoNewPrivileges=yes
# Strip every Linux capability; kenward binds no privileged port and needs
# none of them.
CapabilityBoundingSet=
AmbientCapabilities=
# Blocks the (S)UID/(S)GID bits from taking effect on any binary this unit
# executes, closing the usual privilege-escalation path NoNewPrivileges
# doesn't cover by itself.
RestrictSUIDSGID=yes

# --- Kernel / system surface ---
# Read-only view of kernel tunables (/proc/sys, /sys) — kenward never needs
# to write one.
ProtectKernelTunables=yes
# Kernel module loading is irrelevant to a userspace HTTPS client; deny it.
ProtectKernelModules=yes
# No cgroup writes needed; the unit only ever reads its own resource usage.
ProtectControlGroups=yes
# No need to create new namespaces of any kind.
RestrictNamespaces=yes
# Locks the process's execution domain (personality) — an obscure but
# free hardening knob with no legitimate use here.
LockPersonality=yes
# Refuses to mark writable memory executable afterwards, closing off a class
# of exploit primitive. Pure Go binaries (kenward has no cgo) don't need a
# JIT and are unaffected; loosen only if a future dependency needs one.
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
# No System V / POSIX IPC objects are needed; ensures none it might create
# outlive it either.
RemoveIPC=yes

# Sockets only, restricted to what outbound HTTPS to Telegram/providers and
# local name resolution need. AF_UNIX is for the system resolver (e.g.
# systemd-resolved's NSS socket); kenward opens no listening socket at all.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Broad allow-list covering ordinary network service behaviour (connect,
# read/write, basic process management for the spawned `lore` subprocess)
# without the dangerous syscall groups (@raw-io, @reboot, @swap, @module,
# etc). Loosen only with a specific syscall added via a second
# SystemCallFilter= line, never by removing this one.
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Files this process creates (state directory contents, temp files) are not
# group/world-readable by default.
UMask=0077

[Install]
WantedBy=multi-user.target
